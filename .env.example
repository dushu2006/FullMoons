# Optional — the public website works without any of these set.
# Only /api/health uses the database; without DATABASE_URL it reports
# { "ok": false, "database": "not_configured" } instead of crashing.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db

# Used for canonical metadata, robots and sitemap URLs in production.
NEXT_PUBLIC_SITE_URL=https://your-production-domain.com
